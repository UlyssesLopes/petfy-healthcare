<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.petfy.healthcare</groupId>
    <artifactId>petfy-healthcare</artifactId>
    <version>1.0.0</version>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- acima do que o Boot 3.3.5 gerencia (1.19.8): o docker-java daquela
             versao negocia a API do Docker em 1.32, e daemon moderno recusa
             abaixo de 1.41. O sintoma era silencioso - os testes de container
             eram pulados em vez de falhar, entao migration nenhuma era validada
             contra Postgres de verdade -->
        <testcontainers.version>1.20.4</testcontainers.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Do Flyway 10 (que veio junto do Boot 3.2) o suporte a Postgres
             saiu do core e virou modulo proprio. Sem esta dependencia o
             Flyway sobe mas recusa o banco com "Unsupported Database:
             PostgreSQL 14.x". -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- health check: o provedor de hospedagem precisa de um endpoint para
             saber se a instancia subiu, e o /health do actuator ja checa o
             banco junto -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- o jjwt divide api e implementacao de proposito: so a api aparece
             em tempo de compilacao, o resto entra apenas em runtime -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Postgres de verdade nos testes. O H2 nao serve para validar as
             migrations nem as consultas por UUID - ver PostgresContainerTest -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>net.sourceforge.tess4j</groupId>
            <artifactId>tess4j</artifactId>
            <version>5.6.0</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- springdoc 2.x exige Boot 3; a 1.6.x era a linha do Boot 2.
             O BOM do Boot 3.3 nao gerencia esta dependencia, entao a versao
             vem aqui mesmo. 2.6.0 e a ultima disponivel para Boot 3.3.x. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!-- rate limiting por IP em endpoints publicos sensiveis (brute force de
             login, flood de cadastro). Cache em memoria e suficiente porque a
             aplicacao roda em instancia unica - decisao registrada no ROADMAP.
             Nao ha dependencia de Redis ou Hazelcast. -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>

        <!-- metricas via Micrometer expostas em /actuator/prometheus. A versao vem
             do BOM do Boot 3, sem hardcode aqui. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Heap explicito, para a suite nao depender do ergonomico da JVM,
                         que e fracao da RAM e varia por maquina.

                         O sintoma que levou a isto: na suite completa, TODA classe
                         *ContainerTest era pulada com "Docker is not available" e o build
                         fechava VERDE - sem uma migration validada contra Postgres. Em
                         execucao isolada as mesmas classes passavam.

                         A causa raiz nao esta comprovada. O isDockerAvailable() do
                         Testcontainers engole qualquer Throwable e devolve false, entao o
                         motivo real nao aparece em log nenhum. Fixar o heap fez o sintoma
                         desaparecer de forma reproduzivel (tres execucoes completas), mas
                         isso e evidencia, nao explicacao - e o valor de 2g e menor que o
                         default desta maquina, o que enfraquece a hipotese de memoria.

                         Quem garante que o problema nao volta em silencio nao e esta
                         linha: e o ContainerTestsHabilitadosTest, que FALHA quando o
                         Testcontainers nao acha Docker.

                         @{argLine} preserva o agente do JaCoCo, que injeta o proprio
                         argumento nessa mesma propriedade. -->
                    <argLine>@{argLine} -Xmx2g</argLine>
                    <systemPropertyVariables>
                        <!-- o docker-java assume 1.32 quando a negociacao pelo
                             named pipe do Windows falha, e daemon moderno recusa
                             abaixo de 1.41. Sem isto os testes de container sao
                             pulados em silencio: build verde sem nenhuma migration
                             validada contra Postgres de verdade -->
                        <api.version>1.44</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <!-- 0.8.8 nao instrumenta bytecode de Java 21 e enchia o build
                     de "Unsupported class file major version 65" na maquina
                     local, que roda JDK 21 mesmo o projeto tendo target 17 -->
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>3.9.1.2184</version>
            </plugin>
        </plugins>
    </build>

</project>